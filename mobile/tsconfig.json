{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // Removed invalid 'ignoreDeprecations' option
    "baseUrl": ".",
    "types": ["node", "react", "react-native"],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "__tests__"]
}